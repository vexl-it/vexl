# Server-side proxy targets
CONTACT_INTERNAL_SERVER_URL=http://localhost:3017
CONTENT_INTERNAL_SERVER_URL=http://localhost:3018
CONTENT_API_INTERNAL_URL=http://localhost:3009

# Local backoffice database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=backoffice

# Admin auth. ADMIN_TOKEN is the raw token the internal services check; only
# this server sends it. It also seeds the first admin passkey while none exist.
# BACKOFFICE_ORIGIN is the URL admins open (WebAuthn origin, hostname = RP ID).
ADMIN_TOKEN=dev
BACKOFFICE_ORIGIN=http://localhost:3000
# Dev only, the server refuses to start with it in production: every request
# is treated as a signed-in admin.
# BACKOFFICE_DISABLE_AUTH=true

# Slideshow asset uploads
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=vexl
AWS_SECRET_ACCESS_KEY=vexl-local-secret
S3_BUCKET_NAME=vexl-resources
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
RESOURCES_BASE_URL=http://localhost:9000/vexl-resources

# optional: SENTRY_DSN=
# optional, caches short-link targets for a day: REDIS_URL=redis://localhost:6379

# `admin` (default) serves everything; `public` serves only short-link
# redirects and TV slideshows. Public hosts are used for host routing and for
# the URLs shown in the admin UI.
# BACKOFFICE_MODE=admin
# SHORT_LINKS_HOST=go.vexl.it
# SLIDESHOWS_HOST=slides.vexl.it
