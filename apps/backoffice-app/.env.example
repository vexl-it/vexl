# Server-side proxy targets
CONTACT_API_INTERNAL_URL=http://localhost:3002
CONTENT_API_INTERNAL_URL=http://localhost:3009

# Local backoffice database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=backoffice

# Read-only metrics-service database for the analytics dashboard
METRICS_DB_HOST=localhost
METRICS_DB_PORT=5432
METRICS_DB_USER=postgres
METRICS_DB_PASSWORD=root
METRICS_DB_NAME=metrics
# optional, smallest group of reporting instances shown: ANALYTICS_MIN_GROUP_SIZE=20

# Admin auth and slideshow asset uploads
ADMIN_TOKEN_HASH=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=vexl
AWS_SECRET_ACCESS_KEY=vexl-local-secret
S3_BUCKET_NAME=vexl-resources
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
RESOURCES_BASE_URL=http://localhost:9000/vexl-resources

# optional: SENTRY_DSN=
# optional, caches short-link targets for a day: REDIS_URL=redis://localhost:6379

# `admin` (default) serves everything; `public` serves only short-link
# redirects and TV slideshows. Public hosts are used for host routing and for
# the URLs shown in the admin UI.
# BACKOFFICE_MODE=admin
# SHORT_LINKS_HOST=go.vexl.it
# SLIDESHOWS_HOST=slides.vexl.it

# Comma-separated LAN hostnames/IPs allowed to load Next.js dev resources.
# NEXT_ALLOWED_DEV_ORIGINS=192.168.1.100
