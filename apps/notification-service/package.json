{
  "name": "@vexl-next/notification-service",
  "version": "0.0.0",
  "main": "dist/index.js",
  "type": "module",
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@vexl-next/eslint-config": "0.0.0",
    "@vexl-next/prettier-config": "0.0.0",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "clean": "rimraf .turbo node_modules",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,tsx,md,json}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,tsx,md,json}\"",
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.js",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx -r dotenv/config src/index.ts",
    "dev:watch": "tsx --watch src/index.ts",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --silent",
    "test:watch": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch"
  },
  "prettier": "@vexl-next/prettier-config",
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@vexl-next/cryptography": "0.0.0",
    "@vexl-next/domain": "0.0.0",
    "@vexl-next/esbuild": "0.0.0",
    "@vexl-next/localization": "0.0.0",
    "@vexl-next/resources-utils": "0.0.0",
    "@vexl-next/rest-api": "0.0.0",
    "@vexl-next/server-utils": "0.0.0",
    "bullmq": "^5.52.1",
    "dotenv": "^16.4.5",
    "effect": "4.0.0-rc.112",
    "expo-server-sdk": "^5.0.0",
    "ioredis": "^5.4.1"
  }
}
