{
  "name": "vexl-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "lint:fix": "eslint app src --fix",
    "format": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,tsx,md,json,css}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,tsx,md,json,css}\""
  },
  "dependencies": {
    "effect": "^3.20.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.1",
    "matter-js": "^0.20.0",
    "next": "^16.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "split-type": "^0.3.4"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.10.5",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@vexl-next/eslint-config": "0.0.0",
    "@vexl-next/prettier-config": "0.0.0",
    "@vexl-next/tsconfig": "0.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.3.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prettier": "@vexl-next/prettier-config"
}
