{
  "name": "@vexl-next/rest-api",
  "version": "0.0.0",
  "type": "module",
  "main": "src/index",
  "scripts": {
    "clean": "rimraf .turbo node_modules",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,tsx,md,json}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,tsx,md,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --silent"
  },
  "devDependencies": {
    "@vexl-next/eslint-config": "0.0.0",
    "@vexl-next/generic-utils": "0.0.0",
    "@vexl-next/prettier-config": "0.0.0",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "rimraf": "^4.4.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@vexl-next/cryptography": "0.0.0",
    "@vexl-next/domain": "0.0.0",
    "effect": "4.0.0-rc.112"
  },
  "prettier": "@vexl-next/prettier-config"
