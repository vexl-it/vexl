# Access keys for the standalone geocoding Postgres. Copy to `.env` — the
# refresh pipeline (scripts/refresh.sh via `pnpm refresh:geocoding`) and the
# dev scripts read it automatically. Variables already exported in the
# environment take precedence. Keep values unquoted: the file doubles as the
# `docker run --env-file` for the containerized refresh, which takes lines
# verbatim.
GEOCODING_DB_URL=postgresql://localhost:5433/geocoding
GEOCODING_DB_USER=postgres
GEOCODING_DB_PASSWORD=root

# Optional: Slack incoming-webhook URL — the refresh posts a message when the
# run completes or fails. Leave unset for dev runs.
# SLACK_ALERT_WEBHOOK_URL=
