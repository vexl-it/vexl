{
  "name": "@vexl-next/location-db-updater",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.js",
    "clean": "rimraf .turbo node_modules",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{js,mjs,cjs,jsx,ts,tsx,md,json}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,cjs,jsx,ts,tsx,md,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --silent",
    "test:watch": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch",
    "ingest:geocoding": "tsx -r dotenv/config scripts/ingest.ts",
    "refresh:geocoding": "sh scripts/refresh.sh",
    "seed:dev-geocoding": "tsx -r dotenv/config scripts/seedDev.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@vexl-next/geocoding-db": "0.0.0",
    "effect": "4.0.0-rc.112",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@effect/sql-pg": "4.0.0-rc.112",
    "@types/jest": "^29.4.0",
    "@types/pg": "^8",
    "@vexl-next/esbuild": "0.0.0",
    "@vexl-next/eslint-config": "0.0.0",
    "@vexl-next/prettier-config": "0.0.0",
    "@vexl-next/server-utils": "0.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "rimraf": "^4.4.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.16.0",
    "typescript": "~6.0.3"
  },
  "prettier": "@vexl-next/prettier-config"
}
